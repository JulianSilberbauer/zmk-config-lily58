#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        nvim_ft: nvim_ft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp SPACE>,
                <&macro_wait_time 100>,
                <&kp F>,
                <&macro_wait_time 100>,
                <&kp T>;

            label = "NVIM_FT";
        };

        nvim_tele_grep: nvim_tele_grep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp SPACE>,
                <&macro_wait_time 100>,
                <&kp F>,
                <&macro_wait_time 100>,
                <&kp G>;

            label = "NVIM_TELE_GREP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7         &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y   &kp U          &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H   &kp J          &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp ENTER  &mo 2   &kp BACKSPACE  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&kp ESC           &kp F1        &kp F2        &kp F3        &kp F4         &kp F5                                          &kp F6     &kp F7         &kp F8   &kp F9     &kp F10  &kp F11
&kp TAB           &kp N7        &kp N8        &kp N9        &kp FSLH       &kp EQUAL                                       &kp MINUS  &kp BSLH       &trans   &trans     &trans   &kp F12
&kp LEFT_SHIFT    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp LESS_THAN  &kp GREATER_THAN                                &kp LEFT   &kp DOWN       &kp UP   &kp RIGHT  &trans   &trans
&kp LEFT_CONTROL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans         &kp APOS          &kp LS(LPAR)    &kp LS(RPAR)  &kp SEMI   &trans         &trans   &trans     &trans   &trans
                                              &kp LEFT_ALT  &kp LEFT_GUI   &trans            &kp TAB         &kp ENTER     &trans     &kp BACKSPACE  &kp DEL
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &nvim_ft                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &nvim_tele_grep                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans           &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans           &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
